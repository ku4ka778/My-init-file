;; CustomFile
(setq custom-file (expand-file-name "custom.el" user-emacs-directory))

;; Editor Features
(setq display-line-numbers-type 'relative)
(global-display-line-numbers-mode 1)

(setq-default indent-tabs-mode t)
(setq-default tab-width 4)
(setq-default c-basic-offset 4)
(setq backward-delete-char-untabify-method nil)

(electric-pair-mode 1)

(defun my-insert-tab-literal ()
  (interactive)
  (insert "\t"))

(defun my-smart-tab-handler ()
  (interactive)
  (if (derived-mode-p 'python-mode 'python-ts-mode)
      (insert-char ?\s 4)
    (my-insert-tab-literal)))

(global-set-key (kbd "TAB") #'my-smart-tab-handler)

;; Appearance
(setq native-comp-async-report-warnings-errors 'silent)
(setq byte-compile-warnings '(not unresolved))
(setq-default bidi-display-reordering nil)

(setq frame-resize-pixelwise t)
(setq default-frame-alist
      '((fullscreen . maximized)
        (vertical-scroll-bars . nil)
        (horizontal-scroll-bars . nil)
        (drag-internal-border . t)))

(tool-bar-mode -1)
(menu-bar-mode -1)
(scroll-bar-mode -1)
(tooltip-mode -1)

(column-number-mode 1)

(setq inhibit-startup-screen t)
(setq mouse-highlight nil)
(setq make-pointer-invisible t)

;; Local files
(load (expand-file-name "time-in-emacs.el" user-emacs-directory) t t)
(load custom-file t t)

;; Enable disabled commands
(put 'upcase-region 'disabled nil)
